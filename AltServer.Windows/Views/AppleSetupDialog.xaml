<Window x:Class="AltServer.Windows.Views.AppleSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple ID 配置" Height="520" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🍎 Apple ID" FontSize="22" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="输入 Apple ID 后自动完成设备授权和签名配置" FontSize="13"
                       Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Apple ID (邮箱)" FontSize="13" Margin="0,0,0,6" />
            <TextBox x:Name="AppleIdBox" FontSize="14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                     Margin="0,0,0,14" />

            <TextBlock Text="密码" FontSize="13" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                         BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                         Margin="0,0,0,14" />

            <TextBlock x:Name="TwoFaLabel" Text="双重认证码" FontSize="13" Margin="0,0,0,6"
                       Visibility="Collapsed" />
            <TextBox x:Name="TwoFaCodeBox" FontSize="14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                     Margin="0,0,0,14" Visibility="Collapsed"
                     HorizontalContentAlignment="Center" />
            <TextBlock x:Name="TwoFaHint" Text="请在 iPhone/可信设备上点击&quot;允许&quot;后，输入收到的 6 位验证码"
                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"
                       Visibility="Collapsed" TextWrapping="Wrap" />

            <TextBlock Text="Anisette 服务器 (可选)" FontSize="13" Margin="0,0,0,6" />
            <TextBox x:Name="AnisetteUrlBox" FontSize="13" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" />
            <TextBlock Text="填写你的 iPhone/自建 anisette 地址，如 http://192.168.1.20:6969；留空使用内置服务器"
                       FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <!-- 进度/结果 -->
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#64748B"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="3"
                         Visibility="Collapsed" Background="#E2E8F0" Foreground="#2563EB"
                         Margin="0,0,0,10" />

            <DockPanel>
                <Button Content="跳过" FontSize="13" Padding="16,8" Background="#E2E8F0"
                        Foreground="#475569" BorderThickness="0" Cursor="Hand"
                        Click="OnSkip" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <Button x:Name="SubmitBtn" Content="自动配置" Style="{StaticResource BtnPrimary}"
                        Click="OnSubmit" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
