<Window x:Class="AltServer.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltServer.Windows.Views"
        Title="AltServer" Height="720" Width="1000" MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <local:RunningStateBrushConverter x:Key="RunningStateBrush" />
        <local:ServerStateTextConverter x:Key="ServerStateText" />

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- 顶部标题栏 -->
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="16,10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" Background="#2563EB" CornerRadius="8">
                        <TextBlock Text="🏪" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AltServer" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{Binding IsServerRunning, Mode=OneWay, Converter={StaticResource RunningStateBrush}}"
                            CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White" FontSize="12">
                            <Run Text="● " />
                            <Run Text="{Binding IsServerRunning, Mode=OneWay, Converter={StaticResource ServerStateText}}" />
                        </TextBlock>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="重新检测工具"
                            Click="OnRefreshTools" Margin="0,0,8,0" />

                    <Button Style="{StaticResource PrimaryButton}" Content="隐藏到托盘"
                            Click="OnMinimizeToTray" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F1F5F9" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding ToolsStatus}" FontSize="12" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ProvisionExpiryText}" FontSize="12" />
            </StatusBarItem>
        </StatusBar>

        <!-- 中部内容区 -->
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：设备 + 已安装应用 -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,6,8">
                    <DockPanel>
                        <TextBlock Text="设备" Style="{StaticResource HeaderText}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.Count, StringFormat='{}{0} 台已连接'}"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,6,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备列表" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="刷新设备" Click="OnRefreshDevices"
                                    FontSize="12" Padding="8,4" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" CornerRadius="6" Margin="0,1">
                                        <DockPanel>
                                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding DisplayName}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#64748B"
                                                           Text="{Binding Udid}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#64748B"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OsVersion}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="已安装应用" Style="{StaticResource HeaderText}" />
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="#64748B"
                                       Text="{Binding InstalledApps.Count, StringFormat='{}{0} 个应用'}" />
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding InstalledApps}" BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="11" Foreground="#64748B"
                                                       Text="{Binding BundleIdentifier}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Version}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右列：操作面板 -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Apple ID 签名管理 (对齐爱思助手) -->
                <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="6,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Apple ID 签名管理" Style="{StaticResource HeaderText}" />
                            <Button DockPanel.Dock="Right" Content="🔑 登录 / 切换账号" FontSize="12" Padding="10,4"
                                    Click="OnOpenAppleLogin" />
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="账号:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AppleIdDisplay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="签名状态:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProvisionExpiryText, FallbackValue='未配置证书'}" FontSize="12" VerticalAlignment="Center" Foreground="#2563EB" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作区 -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="6,0,0,8">
                    <StackPanel>
                        <TextBlock Text="操作" Style="{StaticResource HeaderText}" Margin="0,0,0,10" />

                        <DockPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="安装/签名 IPA"
                                    Click="OnInstallIpa" Padding="16,10" />
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="#64748B" FontSize="12"
                                       Text="{Binding SelectedDevice.Name, StringFormat='目标: {0}'}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="配对设备"
                                    Click="OnPairDevice" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="刷新签名"
                                    Click="OnRefreshSigning" IsEnabled="{Binding IsServerRunning, Mode=OneWay}" />
                        </StackPanel>

                        <CheckBox Content="自动刷新（每6小时）" Margin="0,10,0,0"
                                  IsChecked="{Binding AutoRefreshEnabled}" />
                    </StackPanel>
                </Border>

                <!-- 日志区 -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="日志" Style="{StaticResource HeaderText}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="复制全部" FontSize="12" Padding="8,4"
                                        Click="OnCopyAllLogs" Margin="0,0,8,0" />
                                <Button Content="清空" FontSize="12" Padding="8,4"
                                        Click="OnClearLogs" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding LogText, Mode=OneWay}"
                             Background="#0F172A" Foreground="White"
                             FontFamily="Consolas" FontSize="12"
                             BorderThickness="0" Padding="4" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>