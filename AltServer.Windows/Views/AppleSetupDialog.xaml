<Window x:Class="AltServer.Windows.Views.AppleSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple ID 配置" Height="580" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🍎 Apple ID 配置" FontSize="22" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="登录后需手动提供证书和配置文件" FontSize="13"
                       Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <!-- 认证状态 -->
            <Border x:Name="AuthStatusBorder" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="AuthStatusText" FontSize="13" Foreground="#0369A1" TextWrapping="Wrap" />
                    <TextBlock x:Name="AuthStatusHint" FontSize="11" Foreground="#0284C7" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Apple ID + 密码 -->
            <StackPanel x:Name="LoginPanel">
                <TextBlock Text="Apple ID (邮箱)" FontSize="13" Margin="0,0,0,6" />
                <TextBox x:Name="AppleIdBox" FontSize="14" Padding="10,8"
                         BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                         Margin="0,0,0,14" />

                <TextBlock Text="密码" FontSize="13" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                             Margin="0,0,0,14" />

                <!-- 2FA -->
                <StackPanel x:Name="TwoFaPanel" Visibility="Collapsed">
                    <TextBlock Text="双重认证码" FontSize="13" Margin="0,0,0,6" />
                    <TextBox x:Name="TwoFaCodeBox" FontSize="14" Padding="10,8"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                             Margin="0,0,0,10"
                             HorizontalContentAlignment="Center" />
                    <TextBlock x:Name="TwoFaHint" Text="请在 iPhone/可信设备上点击&quot;允许&quot;后，输入收到的 6 位验证码"
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Anisette -->
                <TextBlock Text="Anisette 服务器 (可选)" FontSize="13" Margin="0,0,0,6" />
                <TextBox x:Name="AnisetteUrlBox" FontSize="13" Padding="10,8"
                         BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                         Margin="0,0,0,4" />
                <TextBlock Text="留空使用内置服务器；填写自建地址如 http://192.168.1.20:6969"
                           FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 证书文件选择 -->
            <StackPanel x:Name="CertPanel" Visibility="Collapsed">
                <TextBlock Text="📜 证书文件 (.p12)" FontSize="13" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="P12PathBox" FontSize="12" Padding="8,6"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"
                             IsReadOnly="True" />
                    <Button Grid.Column="1" Content="选择..." Padding="10,6" Margin="4,0,0,0"
                            Style="{StaticResource BtnSecondary}" Click="OnBrowseP12" />
                </Grid>

                <TextBlock Text="📋 配置文件 (.mobileprovision)" FontSize="13" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProvisionPathBox" FontSize="12" Padding="8,6"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"
                             IsReadOnly="True" />
                    <Button Grid.Column="1" Content="选择..." Padding="10,6" Margin="4,0,0,0"
                            Style="{StaticResource BtnSecondary}" Click="OnBrowseProvision" />
                </Grid>

                <TextBlock Text="提示：可在 macOS Keychain Access 中导出 .p12，或在开发者门户下载 .mobileprovision"
                           FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#64748B"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="3"
                         Visibility="Collapsed" Background="#E2E8F0" Foreground="#2563EB"
                         Margin="0,0,0,10" />

            <DockPanel>
                <Button Content="跳过" FontSize="13" Padding="16,8" Background="#E2E8F0"
                        Foreground="#475569" BorderThickness="0" Cursor="Hand"
                        Click="OnSkip" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <Button x:Name="SubmitBtn" Content="登录" Style="{StaticResource BtnPrimary}"
                        Click="OnSubmit" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
