<Window x:Class="AltServer.Windows.Views.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时投屏预览" Height="820" Width="480"
        MinHeight="400" MinWidth="320"
        WindowStartupLocation="CenterScreen" Background="#0B1220">

    <DockPanel>
        <!-- 底部控制栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <CheckBox x:Name="AutoRefreshBox" Content="自动刷新" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
                        <CheckBox x:Name="TopmostBox" Content="窗口置顶" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
                        <Button Content="📸 保存截图" Click="OnSaveScreenshot" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="📋 复制截图" Click="OnCopyScreenshot" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="🔄 刷新" Click="OnRefreshOnce" Padding="10,6" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="连接中..." VerticalAlignment="Center"
                               FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 画面 -->
        <Grid>
            <Image x:Name="ScreenImage" Stretch="Uniform" Margin="8" />

            <!-- 无线 AirPlay 引导面板 (免阻塞弹窗) -->
            <Border x:Name="AirPlayGuidePanel" Background="#1E293B" CornerRadius="12" Margin="24"
                    Padding="24" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📱 投屏与屏幕镜像说明" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="iOS 17/18+ 系统级投屏机制" FontSize="12" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,6,0,16" />

                    <Border Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📌 连接方式与说明：" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                            <TextBlock Text="• iOS 17/18 限制：苹果官方已在 iOS 17+ 废弃 USB 底层截屏通道 (screenshotr 错误 -27)。" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3" />
                            <TextBlock Text="• USB 有线流：需在手机「设置 > 隐私与安全性 > 开发者模式」中开启并重启设备。" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3" />
                            <TextBlock Text="• 无线 AirPlay 镜像：iPhone 从右上角向下滑出「控制中心」，点击「屏幕镜像」即可直接无线同步投屏。" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,3" />
                        </StackPanel>
                    </Border>

                    <Button Content="🔄 重试连接检测" Click="OnRefreshOnce"
                            Background="#3B82F6" Foreground="White" FontWeight="SemiBold" FontSize="13"
                            Padding="16,8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
