<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AltServer.Windows</RootNamespace>
    <AssemblyName>AltServer</AssemblyName>
    <Version>1.0.88</Version>
    <AssemblyVersion>1.0.88.0</AssemblyVersion>
    <FileVersion>1.0.88.0</FileVersion>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 单文件发布：.NET 运行时内嵌，用户无需安装任何 .NET 组件 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI 密码加密存储（账号登录持久化） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tools\ 目录下的第三方工具（libimobiledevice、zsign、asrp64.dll、CoreADI.dll）

      【本地发布】：先运行 scripts\download-windows-tools.ps1 下载工具到 tools\，
                   再手动将 tools\ 复制到发布输出目录（与 CI 的 build-release.yml 做法一致，
                   因为 Content 条目在部分 SDK 版本的 publish 管线中不会复制到 PublishDir）。
      【CI 发版】：build-release.yml 会把工具直接下载/复制到 build\AltServer-Windows\tools\ 后整体打 zip。
    -->

    <!-- asrp64.dll：Apple 认证辅助库（必需） -->
    <Content Include="tools\asrp64.dll" Condition="Exists('tools\asrp64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\asrp64.dll</TargetPath>
    </Content>

    <!-- CoreADI.dll：Apple 本地 Anisette 库（必需，来自 iTunes/Apple Application Support） -->
    <Content Include="tools\an\CoreADI.dll" Condition="Exists('tools\an\CoreADI.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\an\CoreADI.dll</TargetPath>
    </Content>

    <!-- libimobiledevice 工具：idevice_id、ideviceinfo、ideviceinstaller、idevicepair -->
    <Content Include="tools\idevice_id.exe" Condition="Exists('tools\idevice_id.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\idevice_id.exe</TargetPath>
    </Content>
    <Content Include="tools\ideviceinfo.exe" Condition="Exists('tools\ideviceinfo.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\ideviceinfo.exe</TargetPath>
    </Content>
    <Content Include="tools\ideviceinstaller.exe" Condition="Exists('tools\ideviceinstaller.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\ideviceinstaller.exe</TargetPath>
    </Content>
    <Content Include="tools\idevicepair.exe" Condition="Exists('tools\idevicepair.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\idevicepair.exe</TargetPath>
    </Content>

    <!-- zsign：IPA 签名工具 -->
    <Content Include="tools\zsign.exe" Condition="Exists('tools\zsign.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\zsign.exe</TargetPath>
    </Content>

    <!-- libimobiledevice 依赖 DLL（如 libssl、libcrypto 等），通配符批量包含 -->
    <Content Include="tools\*.dll" Exclude="tools\asrp64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>