<Window x:Class="AltServer.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltServer.Windows.Views"
        Title="AltServer - iOS 设备管理与签名中心" Height="780" Width="1180" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <local:RunningStateBrushConverter x:Key="RunningStateBrush" />
        <local:ServerStateTextConverter x:Key="ServerStateText" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:DaysRemainingBrushConverter x:Key="DaysRemainingBrush" />
        <local:NavActiveBackgroundConverter x:Key="NavActiveBg" />
        <local:NavActiveForegroundConverter x:Key="NavActiveFg" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部爱思风格深蓝标题横条 -->
            <RowDefinition Height="52" />
            <!-- 中间主工作区 -->
            <RowDefinition Height="*" />
            <!-- 底部轻量状态条 -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部爱思风格全局导航条 -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="16,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#3B82F6" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="📱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AltServer 爱思版" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#BFDBFE" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 顶栏快捷标签 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Border Background="#2563EB" CornerRadius="6" Padding="14,6" Margin="0,0,8,0">
                        <TextBlock Text="我的设备" FontWeight="Bold" Foreground="White" FontSize="13" />
                    </Border>
                </StackPanel>

                <!-- 右侧服务状态与控制 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding IsServerRunning, Mode=OneWay, Converter={StaticResource RunningStateBrush}}"
                            CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Foreground="White" FontSize="12">
                            <Run Text="● " />
                            <Run Text="{Binding IsServerRunning, Mode=OneWay, Converter={StaticResource ServerStateText}}" />
                        </TextBlock>
                    </Border>

                    <Button Content="重新检测工具" Click="OnRefreshTools" FontSize="12" Padding="10,5"
                            Background="#1D4ED8" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" />
                    <Button Content="最小化到托盘" Click="OnMinimizeToTray" FontSize="12" Padding="10,5"
                            Background="#1D4ED8" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 中部主体：仿爱思助手经典布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左栏：设备切换与爱思功能菜单导航 (240px) -->
                <ColumnDefinition Width="240" />
                <!-- 右栏：对应功能主内容区 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid Margin="10,12,10,12">
                    <Grid.RowDefinitions>
                        <!-- 设备下拉与状态 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 菜单导航项 -->
                        <RowDefinition Height="*" />
                        <!-- 底部快捷操作 -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 设备选择卡片 -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="当前连接设备" FontSize="11" Foreground="#64748B" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.Count, StringFormat='{}{0} 台'}" FontSize="11" Foreground="#2563EB" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName" Padding="8,6" Background="White"
                                      BorderBrush="#CBD5E1" Cursor="Hand" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding SelectedDevice.ProductType, FallbackValue='未连接设备'}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                <Button DockPanel.Dock="Right" Content="刷新设备" Click="OnRefreshDevices" FontSize="11" Padding="6,2"
                                        Style="{StaticResource OutlineButton}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,8" />

                    <!-- 爱思经典垂直功能菜单 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. 设备信息 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToDeviceInfo"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=device_info}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="📱" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="设备信息" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=device_info}" />
                                </DockPanel>
                            </Border>

                            <!-- 2. 照片与视频管理 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToPhotos"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=photos}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="🖼" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="照片与视频" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=photos}" />
                                </DockPanel>
                            </Border>

                            <!-- 3. 应用管理 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToApps"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=apps}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="📦" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="应用管理" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=apps}" />
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstalledApps.Count}" FontSize="11" Foreground="#64748B" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- 4. 实时投屏 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToMirror"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=mirror}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="📺" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="实时投屏" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=mirror}" />
                                </DockPanel>
                            </Border>

                            <!-- 5. 虚拟 U 盘 / 文件系统 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToFiles"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=files}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="💽" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="虚拟U盘 / 文件" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=files}" />
                                </DockPanel>
                            </Border>

                            <!-- 6. 核心：自签名与 IPA 安装（无缝整合） -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToSignInstall"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=sign_install}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="🔑" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="自签名与安装" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=sign_install}" />
                                    <Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="核心" FontSize="10" Foreground="#D97706" FontWeight="Bold" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- 7. 系统日志 -->
                            <Border CornerRadius="6" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="OnNavToLogs"
                                    Background="{Binding CurrentNavView, Converter={StaticResource NavActiveBg}, ConverterParameter=logs}">
                                <DockPanel Margin="12,10">
                                    <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CurrentNavView, Converter={StaticResource NavActiveFg}, ConverterParameter=logs}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部配对与证书简报 -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="配对状态:" FontSize="11" Foreground="#64748B" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDevice.IsPaired, Converter={StaticResource ServerStateText}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" />
                            </DockPanel>
                            <Button Content="一键配对信任" Click="OnPairDevice" Margin="0,6,0,0" FontSize="11" Padding="8,4"
                                    Style="{StaticResource OutlineButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：对应功能展示区（根据 CurrentNavView 切换） -->
            <Grid Grid.Column="1" Margin="14" Background="#F1F5F9">

                <!-- 视图 1：设备信息面板 (仿爱思助手综合概览) -->
                <Grid x:Name="ViewDeviceInfo">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 设备顶栏形象卡片 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <Border Width="64" Height="64" Background="#EEF2FF" CornerRadius="32" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedDeviceDetail.ModelName, FallbackValue='iPhone'}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDeviceDetail.ActivationState, FallbackValue='已激活'}" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                                    <Run Text="{Binding SelectedDevice.DisplayName, Mode=OneWay}" />
                                    <Run Text=" · iOS " />
                                    <Run Text="{Binding SelectedDeviceDetail.ProductVersion, FallbackValue='--'}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding SelectedDeviceDetail.BuildVersion, FallbackValue='--'}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="独立窗口查看" Click="OnDeviceDetail" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                                <Button Content="刷新详情" Click="OnRefreshDeviceInfo" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 下方参数卡片网格 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 存储与电池 (爱思助手看点) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 存储 -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 存储空间占用" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8" />
                                        <ProgressBar Height="10" Background="#E2E8F0" Foreground="#2563EB"
                                                     Value="{Binding SelectedDeviceDetail.DiskUsagePercentage, Mode=OneWay, FallbackValue=0}" Margin="0,0,0,8" />
                                        <DockPanel>
                                            <TextBlock Text="{Binding SelectedDeviceDetail.UsedDiskText, StringFormat='已用: {0}'}" FontSize="11" Foreground="#64748B" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDeviceDetail.TotalDiskCapacityText, StringFormat='总容量: {0}'}"
                                                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 电池健康 -->
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔋 电池健康度与状态" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="当前电量" FontSize="11" Foreground="#64748B" />
                                                <TextBlock Text="{Binding SelectedDeviceDetail.BatteryCurrentCapacity, StringFormat='{}{0}%'}"
                                                           FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="循环次数 / 电池效率" FontSize="11" Foreground="#64748B" />
                                                <TextBlock Text="{Binding SelectedDeviceDetail.BatteryHealthText, FallbackValue='100%'}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 硬件与型号参数 -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🛠 硬件参数与序列号" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="设备型号:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.ModelNumber, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="内部代号:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.ProductType, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="序列号(SN):" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.SerialNumber, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="CPU架构:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.CpuArchitecture, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Wi-Fi MAC:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.WiFiAddress, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="蓝牙地址:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedDeviceDetail.BluetoothAddress, FallbackValue='--'}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <TextBlock Text="设备 UDID:" Width="90" FontSize="12" Foreground="#64748B" />
                                            <TextBox Text="{Binding SelectedDevice.Udid, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" FontSize="12" Foreground="#2563EB" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 快捷启动工具卡片 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="⚡ 设备快捷管理功能" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <Button Content="🖼 照片管理 (图库/相册/导出)" Click="OnPhotos" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" Padding="14,8" />
                                        <Button Content="📺 实时投屏与截屏" Click="OnMirrorPreview" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" Padding="14,8" />
                                        <Button Content="💽 虚拟U盘 / 文件浏览" Click="OnFileSystem" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" Padding="14,8" />
                                        <Button Content="🔑 签名与安装应用" Click="OnJumpToSignInstall" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" Padding="14,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 视图 2：应用管理面板 -->
                <Grid x:Name="ViewApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="📦 应用管理" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding InstalledApps.Count, StringFormat='已在设备上检测到 {0} 个应用'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="安装外部 IPA" Click="OnInstallIpa" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="刷新应用列表" Click="OnRefreshApps" Style="{StaticResource OutlineButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <ListView ItemsSource="{Binding InstalledApps}" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="应用名称" Width="260" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Bundle ID" Width="280" DisplayMemberBinding="{Binding BundleIdentifier}" />
                                    <GridViewColumn Header="版本号" Width="120" DisplayMemberBinding="{Binding Version}" />
                                    <GridViewColumn Header="构建号" Width="100" DisplayMemberBinding="{Binding Build}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- 视图 3：核心自签名与 IPA 安装（原本完整功能全部融合呈现） -->
                <Grid x:Name="ViewSignInstall" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部账号与签名状态卡片 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：账号管理 -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Apple ID 账号管理" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <Button DockPanel.Dock="Right" Content="🔑 登录/添加" Click="OnOpenAppleLogin" FontSize="11" Padding="8,3"
                                            Style="{StaticResource OutlineButton}" />
                                </DockPanel>

                                <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                         Height="80" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding DaysRemaining, Converter={StaticResource DaysRemainingBrush}}" />
                                                <TextBlock Text="{Binding Display}" FontWeight="Medium" FontSize="12" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="设为当前" Click="OnSetActiveAccount" FontSize="11" Padding="8,3" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" />
                                    <Button Content="移除账号" Click="OnRemoveAccount" FontSize="11" Padding="8,3" Style="{StaticResource OutlineButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 右：签名证书状态与一键安装 -->
                            <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前签名证书与安装动作" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProvisionExpiryText, FallbackValue='未配置签名证书'}" FontSize="12" Foreground="#2563EB" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="选择外部 IPA 并签名安装" Click="OnInstallIpa" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                        <Button Content="刷新签名配置" Click="OnRefreshSigning" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                                    </StackPanel>

                                    <CheckBox Content="自动刷新签名（每 6 小时自动续签）" Margin="0,10,0,0"
                                              IsChecked="{Binding AutoRefreshEnabled}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 下部：本地 IPA 软件库 -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 本地 IPA 应用库" FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding IpaLibrary.Count, StringFormat='({0} 个包)'}" FontSize="12" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="添加本地 IPA" Click="OnAddIpa" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" />
                                    <Button Content="移除" Click="OnRemoveIpa" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" />
                                    <Button Content="签名并安装到设备" Click="OnInstallFromLibrary" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </DockPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding IpaLibrary}" SelectedItem="{Binding SelectedIpa}"
                                     BorderThickness="0" Background="Transparent" MouseDoubleClick="OnIpaLibraryDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" CornerRadius="6" Background="#F8FAFC" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" FontSize="13" />
                                                    <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding BundleId}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 视图 4：系统日志面板 -->
                <Grid x:Name="ViewLogs" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📋 AltServer 运行日志" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="复制全部日志" Click="OnCopyAllLogs" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                                    <Button Content="清空日志" Click="OnClearLogs" Style="{StaticResource OutlineButton}" />
                                </StackPanel>
                            </DockPanel>

                            <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding LogText, Mode=OneWay}"
                                     Background="#0F172A" Foreground="#F8FAFC" FontFamily="Consolas"
                                     FontSize="12" Padding="8" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#E2E8F0" Padding="12,0">
            <StatusBarItem>
                <TextBlock Text="{Binding ToolsStatus}" FontSize="11" Foreground="#475569" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ProvisionExpiryText}" FontSize="11" Foreground="#2563EB" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ExpirySummaryText, FallbackValue='证书正常'}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
