<Window x:Class="AltServer.Windows.Views.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时投屏预览" Height="820" Width="480"
        MinHeight="400" MinWidth="320"
        WindowStartupLocation="CenterScreen" Background="#0B1220">

    <DockPanel>
        <!-- 底部控制栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <CheckBox x:Name="AutoRefreshBox" Content="自动刷新" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
                        <CheckBox x:Name="TopmostBox" Content="窗口置顶" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
                        <Button Content="📸 保存截图" Click="OnSaveScreenshot" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="📋 复制截图" Click="OnCopyScreenshot" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="🔄 刷新" Click="OnRefreshOnce" Padding="10,6" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="连接中..." VerticalAlignment="Center"
                               FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 画面 -->
        <Grid>
            <Image x:Name="ScreenImage" Stretch="Uniform" Margin="8" />

            <!-- 无线 AirPlay 引导面板 (免阻塞弹窗) -->
            <Border x:Name="AirPlayGuidePanel" Background="#1E293B" CornerRadius="12" Margin="24"
                    Padding="24" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📺 高清无线投屏" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="免开启开发者模式，超低延迟音画同步" FontSize="12" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,6,0,16" />

                    <Button Content="📡 启动 AirPlay 无线投屏" Click="OnStartAirPlay"
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="14"
                            Padding="16,10" Cursor="Hand" Margin="0,0,0,16" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Border Background="#0F172A" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📱 投屏连接步骤：" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <TextBlock Text="1. 点击上方按钮启动投屏组件" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                            <TextBlock Text="2. iPhone 从右上角向下滑出「控制中心」" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                            <TextBlock Text="3. 点击「屏幕镜像」(两个小方块图标)" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                            <TextBlock Text="4. 选择电脑名称，即可实时同步画面！" FontSize="11" Foreground="#10B981" FontWeight="Medium" Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ℹ️ 如需使用 USB 有线截屏流，需在手机「设置 > 隐私与安全性 > 开发者模式」开启。"
                               FontSize="10" Foreground="#64748B" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
