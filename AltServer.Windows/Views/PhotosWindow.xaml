<Window x:Class="AltServer.Windows.Views.PhotosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltServer.Windows.Views"
        Title="照片管理" Height="680" Width="1020" MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Window.Resources>
        <local:BoolToVideoBrushConverter x:Key="BoolToVideoBrush" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FCA5A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：仿爱思助手相簿树/分类导航 -->
        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,4,4,12">
                    <TextBlock Text="相册分类" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock x:Name="AlbumSummaryText" Text="加载中..." FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 相簿列表 -->
                <ListBox Grid.Row="1" x:Name="AlbumsList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnAlbumSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#64748B" />
                                </Border>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2" Background="#E0E7FF" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <TextBlock Text="💡 提示：照片库采用智能数据库索引，支持解析图库与各分类相簿。" FontSize="11" Foreground="#3730A3" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- 右侧：照片列表与工具栏 -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="CurrentAlbumTitle" Text="图库" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock x:Name="DeviceText" Text="" FontSize="12" Foreground="#64748B" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- 视图切换 -->
                    <Border Background="#E2E8F0" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThumbnailModeRadio" Content="🖼 缩略图" IsChecked="True"
                                         GroupName="ViewMode" Checked="OnViewModeChanged"
                                         Padding="8,4" Cursor="Hand" />
                            <RadioButton x:Name="ListModeRadio" Content="📋 列表"
                                         GroupName="ViewMode" Checked="OnViewModeChanged"
                                         Padding="8,4" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <Button Content="🔍 放大查看" Click="OnViewEnlarged" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                    <Button Content="全选" Click="OnSelectAll" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                    <Button Content="⬇ 导出选中" Click="OnExportSelected" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" x:Name="ExportSelectedBtn" />
                    <Button Content="⬇ 导出全部" Click="OnExportAll" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" x:Name="ExportAllBtn" />
                    <Button Content="⬆ 导入照片" Click="OnImport" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" x:Name="ImportBtn" Background="#16A34A" />
                    <Button Content="🗑 删除选中" Click="OnDeleteSelected" Margin="0,0,0,0"
                            Style="{StaticResource DangerButton}" x:Name="DeleteSelectedBtn" />
                </StackPanel>
            </DockPanel>

            <!-- 媒体文件展示区 (双模式：缩略图网格 / 详细列表) -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <!-- 1. 缩略图网格视图 -->
                    <ScrollViewer x:Name="ThumbnailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="ThumbnailList" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="OnItemDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="140" ItemHeight="170" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                            Cursor="Hand" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="36" />
                                            </Grid.RowDefinitions>

                                            <!-- 缩略图图像 -->
                                            <Border Grid.Row="0" CornerRadius="6,6,0,0" ClipToBounds="True" Background="#0F172A">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PlaceholderIcon}" FontSize="28" Foreground="#64748B"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ThumbnailVisibility}" />
                                                    <!-- 视频角标 -->
                                                    <Border Background="#CC000000" CornerRadius="4" Padding="4,1" Margin="4"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Visibility="{Binding VideoBadgeVisibility}">
                                                        <TextBlock Text="▶ 视频" FontSize="10" Foreground="White" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 文件名与大小 -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6,2">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>

                    <!-- 2. 详细列表视图 -->
                    <ListView x:Name="FilesList" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MouseDoubleClick="OnItemDoubleClick" Visibility="Collapsed">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="文件名" Width="320" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="类型" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4,2" HorizontalAlignment="Left"
                                                    Background="{Binding IsVideo, Converter={StaticResource BoolToVideoBrush}}">
                                                <TextBlock Text="{Binding IsVideoText}" FontSize="11" Foreground="White" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="修改/创建时间" Width="180" DisplayMemberBinding="{Binding ModifiedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- 进度 -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100"
                             Background="#E2E8F0" Foreground="#2563EB" Value="0" />
            </StackPanel>

            <!-- 说明 -->
            <Border Grid.Row="3" Background="#EFF6FF" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                <TextBlock FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"
                           Text="导出：将设备上的照片/视频高速保存到本地（流式读取，不占电脑内存）；导入：支持向相机胶卷添加电脑照片，相册即时更新。" />
            </Border>
        </Grid>
    </Grid>
</Window>
