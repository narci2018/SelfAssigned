<Window x:Class="AltServer.Windows.Views.DeviceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备详细信息" Height="700" Width="840" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="100" />
        </Style>

        <Style x:Key="PropValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：设备形象概览 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <Border Width="56" Height="56" Background="#EEF2FF" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DeviceModelText" Text="iPhone" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivationText" Text="已激活" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DeviceSubtitleText" Text="" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="刷新信息" Click="OnRefresh"
                        Padding="12,6" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- 主体信息滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 存储状态与电池健康（爱思核心看点） -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 存储容量 -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="💾 存储空间" Style="{StaticResource SectionTitle}" />
                            <ProgressBar x:Name="DiskProgressBar" Height="10" Background="#E2E8F0" Foreground="#2563EB"
                                         Minimum="0" Maximum="100" Value="0" Margin="0,4,0,8" />
                            <DockPanel>
                                <TextBlock x:Name="DiskUsedText" Text="已用 0 GB" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="DiskTotalText" DockPanel.Dock="Right" Text="共 0 GB (可用 0 GB)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 电池状态 -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🔋 电池状态" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="当前电量 / 状态" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="BatteryCapacityText" Text="-- %" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="循环次数 / 电池效率" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="BatteryHealthText" Text="-- 次 (100%)" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 硬件与出厂参数 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🛠 硬件与型号参数" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="设备型号:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ModelNumberText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="销售地区:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="RegionText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="序列号 (SN):" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="SerialNumberText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="生产日期:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ProductionDateText" Text="--" Style="{StaticResource PropValue}" Foreground="#2563EB" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="内部代号:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ProductTypeText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="硬件代号:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="HardwareModelText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="CPU 架构:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="CpuText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="监管型号:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="RegulatoryModelText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="固件版本:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="BuildVersionText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="越狱状态:" Style="{StaticResource PropLabel}" />
                                <TextBlock Text="未越狱" Style="{StaticResource PropValue}" Foreground="#15803D" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="激活锁(ID锁):" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ActivationLockText" Text="--" Style="{StaticResource PropValue}" Foreground="#DC2626" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="iCloud状态:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ICloudText" Text="--" Style="{StaticResource PropValue}" Foreground="#15803D" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 网络与标识 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🌐 网络与唯一标识" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Wi-Fi MAC:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="WifiMacText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="蓝牙地址:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="BluetoothText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="蜂窝基带:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="BasebandText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="运营商:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="CarrierText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="IMEI1:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="ImeiText" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="IMEI2:" Style="{StaticResource PropLabel}" />
                                <TextBlock x:Name="Imei2Text" Text="--" Style="{StaticResource PropValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="设备 UDID:" Style="{StaticResource PropLabel}" />
                                <TextBox x:Name="UdidBox" Text="--" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="#2563EB" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部快捷控制 -->
        <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="支持全套底层参数实时诊断与验机查询。" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="关闭" Click="OnClose" Padding="16,5" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
