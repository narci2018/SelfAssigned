<Window x:Class="AltServer.Windows.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="照片预览" Height="780" Width="1040" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#090D16"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Text="IMG_0001.JPG" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="IndexText" Text=" (1 / 1)" FontSize="13" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FileInfoText" Text=" · 3.2 MB" FontSize="12" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="⬅ 上一张 (←)" Click="OnPrevClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="下一张 ➡ (→)" Click="OnNextClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="🔍 放大" Click="OnZoomInClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="🔍 缩小" Click="OnZoomOutClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="1:1 原图" Click="OnActualSizeClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="适应窗口" Click="OnFitClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="⬇ 导出" Click="OnExportClick" Style="{StaticResource ToolBtn}" />
                    <Button Content="🗑 删除" Click="OnDeleteClick" Style="{StaticResource DangerBtn}" />
                    <Button Content="✕ 关闭 (Esc)" Click="OnCloseClick" Style="{StaticResource ToolBtn}" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 图片主体展示区（支持缩放与平移） -->
        <ScrollViewer Grid.Row="1" x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#090D16" PreviewMouseWheel="OnScrollViewerMouseWheel">
            <Grid x:Name="ImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="LargeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
                <TextBlock x:Name="LoadingText" Text="正在从设备加载高清大图..." Foreground="#94A3B8"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <!-- 底部状态条 -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,6">
            <DockPanel>
                <TextBlock Text="💡 提示：按键盘 ←/→ 切换上下张，鼠标滚轮可缩放图片，Esc 键退出预览。"
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock x:Name="ZoomPercentText" Text="100%" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
