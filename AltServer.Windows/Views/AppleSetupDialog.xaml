<Window x:Class="AltServer.Windows.Views.AppleSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple ID 登录与签名配置" Height="430" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Apple ID 登录" FontSize="20" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="输入 Apple ID 与密码，系统将全自动配置证书与签名环境" FontSize="12"
                       Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Apple ID (邮箱)" FontSize="13" Margin="0,0,0,6" />
            <TextBox x:Name="AppleIdBox" FontSize="14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                     Margin="0,0,0,12" />

            <TextBlock Text="密码" FontSize="13" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                         BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                         Margin="0,0,0,12" />

            <!-- 2FA 验证码输入框（需要时自动展开） -->
            <StackPanel x:Name="TwoFaPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="双重认证验证码 (2FA)" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,6" />
                <TextBox x:Name="TwoFaCodeBox" FontSize="16" FontWeight="Bold" Padding="10,8"
                         BorderBrush="#2563EB" BorderThickness="2" Background="White"
                         Margin="0,0,0,4"
                         HorizontalContentAlignment="Center" MaxLength="6" />
                <TextBlock Text="请输入受信任苹果设备上弹出的 6 位双重认证验证码"
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 高级设置 -->
            <Expander Header="高级选项 (Anisette 硬件特征服务)" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0">
                <StackPanel Margin="0,6,0,0">
                    <TextBox x:Name="AnisetteUrlBox" FontSize="12" Padding="6,4"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="White" />
                    <TextBlock Text="默认留空即可自动使用内置 Anisette 硬件特征服务" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#64748B"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="4"
                         Visibility="Collapsed" Background="#E2E8F0" Foreground="#2563EB"
                         Margin="0,0,0,10" />

            <DockPanel>
                <Button Content="跳过 / 取消" FontSize="13" Padding="16,8" Background="#E2E8F0"
                        Foreground="#475569" BorderThickness="0" Cursor="Hand"
                        Click="OnSkip" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <Button x:Name="SubmitBtn" Content="登录并自动配置" Style="{StaticResource BtnPrimary}"
                        Click="OnSubmit" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
